{
  "name": "radarpolitico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:client": "vite",
    "build": "tailwindcss -c tailwind.report.config.cjs -i src/styles/report-tailwind.css -o public/report-fiscal.css --minify && vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node server/migrate.js",
    "db:check": "node server/checkDatabase.js",
    "news:ingest": "node server/ingest.js",
    "news:update": "npm run news:ingest && npm run editorial:rebuild",
    "news:repair-descriptions": "node server/repairNewsDescriptions.js",
    "editorial:submit": "node .agents/skills/radar-editorial/scripts/submit-draft.mjs",
    "editorial:rebuild": "node server/rebuildEditorialDrafts.js",
    "images:refresh": "node server/refreshImages.js",
    "media:sync": "node server/syncMediaPool.js",
    "figures:sync": "node server/syncPublicFigures.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "dev:server": "nodemon server/index.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.4.0",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "nodemon": "^2.0.22",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.1.6",
    "vite": "^5.0.0"
  }
}
